# Public site URL for production / canonical domain.
NEXT_PUBLIC_SITE_URL=https://nrinternationalexport.com

# Resend (primary email delivery). Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on enquiry emails. The domain must be verified in Resend.
MAIL_FROM="NR International Export <enquiries@nrinternationalexport.com>"

# Every contact and quote enquiry is sent here.
ENQUIRY_TO_EMAIL=contact@nrinternationalexport.com

# Optional SMTP fallback, used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
