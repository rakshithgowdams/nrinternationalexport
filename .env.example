# Public site URL for production / canonical domain.
NEXT_PUBLIC_SITE_URL=https://nrinternationalexport.com

# Resend (Primary delivery). Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on enquiry emails:
# - Once your domain is verified at https://resend.com/domains:
#   MAIL_FROM="NR International Export <enquiries@nrinternationalexport.com>"
# - During testing before domain verification:
#   MAIL_FROM="NR International Export <onboarding@resend.dev>"
MAIL_FROM="NR International Export <enquiries@nrinternationalexport.com>"

# Where contact and quote enquiries are sent:
# - During testing with onboarding@resend.dev, this MUST be the email address you signed up with at Resend.
# - Once domain is verified or with SMTP, this can be your corporate inbox (contact@nrinternationalexport.com).
ENQUIRY_TO_EMAIL=contact@nrinternationalexport.com

# SMTP fallback (Used automatically if Resend fails, is unverified, or RESEND_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
